{
  "name": "barbershop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @barbershop/web",
    "dev:web:host": "npm run dev --workspace @barbershop/web -- --host 0.0.0.0",
    "dev:api": "npm run dev --workspace @barbershop/api",
    "dev:all": "concurrently -n web,api -c green,blue \"npm run dev:web\" \"npm run dev:api\"",
    "dev:all:host": "concurrently -n web,api -c green,blue \"npm run dev:web:host\" \"npm run dev:api\"",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace @barbershop/web",
    "build:api": "npm run build --workspace @barbershop/api",
    "lint": "eslint .",
    "optimize:images": "npm run optimize:images --workspace @barbershop/web",
    "prisma:generate": "npm run prisma:generate --workspace @barbershop/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @barbershop/api",
    "prisma:studio": "npm run prisma:studio --workspace @barbershop/api",
    "preview": "npm run preview --workspace @barbershop/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prisma": "^7.8.0",
    "sharp": "^0.35.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
